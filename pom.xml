<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.vmware.pscoe.o11n</groupId>
        <artifactId>typescript-project-all</artifactId>
        <version>4.25.0</version>
        <relativePath/>
    </parent>

    <groupId>io.github.mtornblad</groupId>
    <artifactId>nested-vcf-orchestrator</artifactId>
    <!-- vropkg stamps this version onto all elements. Imported certificate
         workflows are already 3.0.0, so avoid publishing an older version. -->
    <version>3.0.1-SNAPSHOT</version>
    <packaging>package</packaging>
    <name>${project.artifactId}</name>
    <description>TypeScript workflows and actions for the Nested VCF Lab.</description>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <generated.from>package-typescript-archetype</generated.from>
        <license.organizationName>Nested VCF Lab contributors</license.organizationName>
        <license.includes></license.includes>
        <license.excludes>**/*</license.excludes>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>stage-native-vro-content</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/vro-sources/xml/src/main/resources</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/native/src/main/resources</directory>
                                    <!-- Preserve JavaScript and vRO expressions literally. -->
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
