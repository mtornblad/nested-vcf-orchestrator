  "schema": {
    "profile_name": {
      "label": "Catalog configuration",
      "description": "Configuration created with Configure Modular Catalog; separate from your Maven build profile.",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": "lab"
    },
    "lab_name": {
      "label": "Lab name",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": "nested-vcf-modular"
    },
    "lab_password": {
      "label": "Shared lab password",
      "description": "Plaintext lab input. Used by guest bootstrap and the generated VCF JSON; no password is stored in source.",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true,
        "min-length": 15
      }
    },
    "vyos_rest_api_key": {
      "label": "VyOS REST API key",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true,
        "min-length": 12
      }
    },
    "deploy_esxi": {
      "label": "Deploy ESXi hosts",
      "description": "",
      "type": {
        "dataType": "boolean",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": true
    },
    "deploy_installer": {
      "label": "Deploy VCF Installer",
      "description": "",
      "type": {
        "dataType": "boolean",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": true
    },
    "deploy_jumphost": {
      "label": "Deploy Windows jumphost",
      "description": "",
      "type": {
        "dataType": "boolean",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": true
    },
    "region_name": {
      "label": "Region",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": "region-dclab"
    },
    "namespace_class": {
      "label": "Namespace class",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": "x-large"
    },
    "seg_name": {
      "label": "Supervisor selector",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": "pco"
    },
    "zone_name": {
      "label": "Zone",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": "domain-c9"
    },
    "storage_policy": {
      "label": "Storage policy",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": "vsan-default-storage-policy"
    },
    "storage_limit_gib": {
      "label": "Namespace storage quota (GiB)",
      "description": "",
      "type": {
        "dataType": "integer",
        "isMultiple": false
      },
      "constraints": {
        "required": true,
        "min-value": 1
      },
      "default": 8192
    },
    "cpu_limit": {
      "label": "Namespace CPU limit",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": "400G"
    },
    "memory_limit_gib": {
      "label": "Namespace memory limit (GiB)",
      "description": "",
      "type": {
        "dataType": "integer",
        "isMultiple": false
      },
      "constraints": {
        "required": true,
        "min-value": 1
      },
      "default": 500
    },
    "dns_prefix": {
      "label": "Hostname prefix",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": "mt"
    },
    "domain_name": {
      "label": "DNS domain",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": "dclab.se"
    },
    "lab_cidr": {
      "label": "Lab private network (/16)",
      "description": "This first modular contract uses /24 networks inside one private /16. Host IPs follow this prefix.",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": "172.16.0.0/16"
    },
    "vlan_base": {
      "label": "First VLAN (management)",
      "description": "",
      "type": {
        "dataType": "integer",
        "isMultiple": false
      },
      "constraints": {
        "required": true,
        "min-value": 1,
        "max-value": 4090
      },
      "default": 1601
    },
    "dns_forwarder": {
      "label": "Upstream DNS server",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": "1.1.1.1"
    },
    "ntp_server": {
      "label": "Upstream NTP server",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": "time1.vyos.net"
    },
    "fabric_mtu": {
      "label": "Nested network MTU",
      "description": "Keeps your tested default. A higher value requires an outer network that carries it.",
      "type": {
        "dataType": "integer",
        "isMultiple": false
      },
      "constraints": {
        "required": true,
        "min-value": 1600,
        "max-value": 9000
      },
      "default": 8800
    },
    "vyos_image": {
      "label": "VyOS VM image",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": "vmi-576b17f7f8892d741"
    },
    "vyos_class": {
      "label": "VyOS VM class",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": true
      },
      "default": "best-effort-medium"
    },
    "esx_image": {
      "label": "ESXi VM image",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": [
          {
            "equals": {
              "deploy_esxi": true
            },
            "value": true
          },
          {
            "equals": {
              "deploy_esxi": false
            },
            "value": false
          }
        ]
      },
      "default": "vmi-0a831a3ed5c05b0a1"
    },
    "esx_class": {
      "label": "ESXi VM class",
      "description": "",
      "type": {
        "dataType": "string",
        "isMultiple": false
      },
      "constraints": {
        "required": [
          {
            "equals": {
              "deploy_esxi": true
            },
            "value": true
          },
          {
            "equals": {
              "deploy_esxi": false
            },
            "value": false
          }
        ]
      },
      "default": "nested-esx-small"
    },
    "esx_count": {
      "label": "Number of ESXi hosts",
      "description": "",
      "type": {
        "dataType": "integer",
        "isMultiple": false
      },
      "constraints": {
        "required": [
          {
            "equals": {
              "deploy_esxi": true
            },
            "value": true
          },
          {
            "equals": {
              "deploy_esxi": false
            },
            "value": false
          }
        ],
        "min-value": 1,
        "max-value": 64
      },
      "default": 4
    },
